Options -Indexes
DirectoryIndex index.html

# (Sem o redirect pra HTTPS da produção — localmente não temos TLS. O resto é
# idêntico ao .htaccess real; esse arquivo só é montado dentro do container.)

# Bloqueia acesso direto a arquivos de configuração e utilitários internos
<FilesMatch "^(config\.php|gerar_hash\.php|retiradas_core\.php|alunos_core\.php|motivos_core\.php|grupos_core\.php|painel_usuarios_core\.php)$">
    Require all denied
</FilesMatch>

# Evita que o navegador guarde CSS/JS/imagens "pra sempre" sem checar se mudou.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|webp)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
